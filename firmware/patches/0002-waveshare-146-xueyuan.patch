@@ -218,6 +221,96 @@ private:
                 gpio_set_level(PWR_Control_PIN, true);
             }
         }, this);
+
+        // 触摸互动(R145b):SPD2010 屏模组集成触摸(Hynitron@0x53,HDP 协议)。
+        // 逐行对照微雪官方 Touch_SPD2010.c 移植——关键口径:
+        //   寄存器地址大端(先高后低);数据字节序 [d0,d1];状态位 st[1]:bit6=in_bios
+        //   bit5=in_cpu bit3=cpu_run;read_len=st[2]|st[3]<<8;HDP 包在 0x0300,包头4B+每点6B。
+        // wiki 所称 CST816S@0x15 有误(总线扫描证实 0x15 不存在,0x53 才是触摸)。
+        struct TpCtx { CustomBoard* board; i2c_master_dev_handle_t tp; };
+        static TpCtx ctx{this, nullptr};
+        i2c_device_config_t tp_cfg = {};
+        tp_cfg.device_address = 0x53;  // 官方 Touch_SPD2010.h: SPD2010_ADDR
+        tp_cfg.scl_speed_hz = 400000;  // 此总线 100k 实测 NACK,须 400k(R143b 取证)
+        if (i2c_master_bus_add_device(i2c_bus_, &tp_cfg, &ctx.tp) != ESP_OK) {
+            ESP_LOGE(TAG, "tp(SPD2010@0x53) add i2c device failed");
+        }
+        gpio_config_t tp_io = {};
+        tp_io.pin_bit_mask = 1ULL << TP_PIN_NUM_INT;
+        tp_io.mode = GPIO_MODE_INPUT;
+        tp_io.pull_up_en = GPIO_PULLUP_ENABLE;
+        gpio_config(&tp_io);
+        xTaskCreate([](void* arg) {
+            auto ctxp = static_cast<TpCtx*>(arg);
+            auto self = ctxp->board;
+            static const char* kEmo[] = {"happy", "laughing", "surprised", "loving", "cool", "sleepy"};
+            static int idx = 0;
+
+            // 官方口径:reg 大端 [rh,rl],数据 [d0,d1]
+            auto wr_cmd = [&](uint8_t rh, uint8_t rl, uint8_t d0, uint8_t d1) {
+                uint8_t buf[4] = {rh, rl, d0, d1};
+                return i2c_master_transmit(ctxp->tp, buf, 4, 100);
+            };
+            auto rd_reg = [&](uint8_t rh, uint8_t rl, uint8_t* out, int n) {
+                uint8_t rb[2] = {rh, rl};
+                return i2c_master_transmit_receive(ctxp->tp, rb, 2, out, n, 200);
+            };
+
+            // 取证:读固件版本(0x2600,18B——官方 read_fw_version,应见 "SPD-2010")
+            {
+                uint8_t fw[18] = {0};
+                if (rd_reg(0x26, 0x00, fw, sizeof(fw)) == ESP_OK) {
+                    char name[9] = {0};
+                    memcpy(name, fw + 14, 4);   // "2010"(低)
+                    memcpy(name + 4, fw + 10, 4); // 拼接展示用
+                    ESP_LOGI(TAG, "tp fw: DVer=%02X%02X", fw[5], fw[4]);
+                }
+            }
+
+            bool was_down = false;
+            for (;;) {
+                uint8_t st[4] = {0};
+                if (rd_reg(0x20, 0x00, st, 4) == ESP_OK) {
+                    bool pt = st[0] & 0x01, gesture = st[0] & 0x02;
+                    bool in_bios = st[1] & 0x40, in_cpu = st[1] & 0x20, cpu_run = st[1] & 0x08, aux = st[1] & 0x08;
+                    uint16_t rlen = st[2] | (st[3] << 8);
+                    if (in_bios) {
+                        wr_cmd(0x02, 0x00, 0x01, 0x00);  // clear int
+                        wr_cmd(0x04, 0x00, 0x01, 0x00);  // cpu start
+                    } else if (in_cpu) {
+                        wr_cmd(0x50, 0x00, 0x00, 0x00);  // point mode
+                        wr_cmd(0x46, 0x00, 0x00, 0x00);  // touch start
+                        wr_cmd(0x02, 0x00, 0x01, 0x00);  // clear int
+                    } else if (cpu_run && rlen == 0) {
+                        wr_cmd(0x02, 0x00, 0x01, 0x00);  // clear int(空闲常态)
+                    } else if (pt || gesture) {
+                        uint8_t hdp[40] = {0};
+                        int n = rlen < 40 ? rlen : 40;
+                        if (rlen >= 10 && rd_reg(0x00, 0x03, hdp, n) == ESP_OK) {
+                            uint8_t check_id = hdp[4];
+                            if (check_id <= 0x0A && pt) {
+                                uint8_t tnum = (rlen - 4) / 6;
+                                uint16_t x = ((hdp[7] & 0xF0) << 4) | hdp[5];
+                                uint16_t y = ((hdp[7] & 0x0F) << 8) | hdp[6];
+                                if (!was_down && tnum > 0) {
+                                    ESP_LOGI(TAG, "tp touch: n=%u (%u,%u) int=%d", tnum, x, y,
+                                             gpio_get_level(TP_PIN_NUM_INT));
+                                    self->GetDisplay()->SetEmotion(kEmo[idx % 6]);
+                                    idx++;
+                                }
+                                was_down = tnum > 0;
+                            }
+                        }
+                        // HDP 完成检查(官方:0x02FC 状态 0x82 则清中断)
+                        uint8_t hs[8] = {0};
+                        if (rd_reg(0xFC, 0x02, hs, 8) == ESP_OK && hs[5] == 0x82) {
+                            wr_cmd(0x02, 0x00, 0x01, 0x00);
+                        }
+                    }
+                }
+                vTaskDelay(pdMS_TO_TICKS(100));
+            }
+        }, "tp_emo", 4096, &ctx, 5, nullptr);
     }
 
 public:
