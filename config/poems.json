{
  "version": "2.0-g4s2",
  "comment": "诗词画廊(2026-11-18 R11 换血):锚定统编语文四年级下册——第一单元古诗词三首 + 第七单元古诗三首。音频命名不变 poem_{id}_0(开场)/poem_{id}_{n}。",
  "poems": [
    {
      "id": "sxxsgd",
      "title": "宿新市徐公店",
      "author": "宋·杨万里",
      "lines": [
        "篱落疏疏一径深",
        "树头新绿未成阴",
        "儿童急走追黄蝶",
        "飞入菜花无处寻"
      ]
    },
    {
      "id": "sstyx",
      "title": "四时田园杂兴(其二十五)",
      "author": "宋·范成大",
      "lines": [
        "梅子金黄杏子肥",
        "麦花雪白菜花稀",
        "日长篱落无人过",
        "惟有蜻蜓蛱蝶飞"
      ]
    },
    {
      "id": "qpycj",
      "title": "清平乐·村居",
      "author": "宋·辛弃疾",
      "lines": [
        "茅檐低小",
        "溪上青青草",
        "醉里吴音相媚好",
        "白发谁家翁媪",
        "大儿锄豆溪东",
        "中儿正织鸡笼",
        "最喜小儿亡赖",
        "溪头卧剥莲蓬"
      ]
    },
    {
      "id": "frlsxj",
      "title": "芙蓉楼送辛渐",
      "author": "唐·王昌龄",
      "lines": [
        "寒雨连江夜入吴",
        "平明送客楚山孤",
        "洛阳亲友如相问",
        "一片冰心在玉壶"
      ]
    },
    {
      "id": "sxx",
      "title": "塞下曲",
      "author": "唐·卢纶",
      "lines": [
        "月黑雁飞高",
        "单于夜遁逃",
        "欲将轻骑逐",
        "大雪满弓刀"
      ]
    },
    {
      "id": "mm",
      "title": "墨梅",
      "author": "元·王冕",
      "lines": [
        "我家洗砚池头树",
        "朵朵花开淡墨痕",
        "不要人夸好颜色",
        "只留清气满乾坤"
      ]
    }
  ]
}